<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title inertia>
      Phila MDT
    </title>

    <!-- Google Tag Manager & Google Analytics (Initialisation différée non-bloquante) -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-03SQWZVCLH', { send_page_view: false });

      function initThirdPartyScripts() {
        if (window.__thirdPartyLoaded) return;
        window.__thirdPartyLoaded = true;

        // Google Tag Manager
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-5PGL39XB');

        // Google Analytics (gtag.js)
        var gaScript = document.createElement('script');
        gaScript.async = true;
        gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-03SQWZVCLH';
        document.head.appendChild(gaScript);
      }

      if ('requestIdleCallback' in window) {
        requestIdleCallback(function() {
          setTimeout(initThirdPartyScripts, 1500);
        });
      } else {
        window.addEventListener('load', function() {
          setTimeout(initThirdPartyScripts, 2000);
        });
      }
    </script>
    <!-- Fin GTM & Google Analytics -->


    <!-- SEO Meta Tags -->
    <meta
      name="description"
      content="Bienvenue à Phila Maison de Témoignages (MDT), un lieu où Dieu transforme des vies en témoignages vivants. Rejoignez-nous pour nos cultes, nos enseignements et partagez notre communion fraternelle."
    />
    <meta
      name="keywords"
      content="phila mdt, église, maison de témoignages, culte, foi, prière, cellules de maison, louange, enseignements, chrétien, communauté"
    />
    <meta name="author" content="Phila MDT" />
    <meta name="robots" content="index, follow" />

    @assign(publicBaseUrl = (appUrl && !appUrl.includes('127.0.0.1') && !appUrl.includes('localhost')) ? appUrl.replace(/\/+$/, '') : 'https://philamdt.church')
    @assign(canonicalUrlClean = (canonicalUrl && !canonicalUrl.includes('127.0.0.1') && !canonicalUrl.includes('localhost')) ? canonicalUrl : publicBaseUrl)
    @assign(ogTitle = page?.props?.event?.title ? page.props.event.title + ' — Phila Maison de Témoignages' : 'Phila Maison de Témoignages')
    @assign(ogDescription = page?.props?.event?.description ? page.props.event.description.slice(0, 200) : 'Découvrez Phila Maison de Témoignages (MDT), notre agenda des cultes, ministères, événements et partagez la communion chrétienne.')
    @assign(ogImage = page?.props?.event?.image ? (page.props.event.image.startsWith('http') ? page.props.event.image : publicBaseUrl + (page.props.event.image.startsWith('/') ? '' : '/') + page.props.event.image) : publicBaseUrl + '/mdt-banner.jpg')

    <!-- Canonical URL (Défense contre l'usurpation SEO) -->
    <link rel="canonical" href="{{ canonicalUrlClean }}" />

    <!-- Open Graph / Facebook / WhatsApp (Détection dynamique Événement vs Pages statiques) -->
    <meta property="og:type" content="{{ page?.props?.event ? 'article' : 'website' }}" />
    <meta property="og:site_name" content="Phila Maison de Témoignages" />
    <meta property="og:url" content="{{ canonicalUrlClean }}" />
    <meta property="og:title" content="{{ ogTitle }}" />
    <meta property="og:description" content="{{ ogDescription }}" />
    <meta property="og:image" content="{{ ogImage }}" />
    <meta property="og:image:secure_url" content="{{ ogImage }}" />
    <meta property="og:image:type" content="{{ ogImage.endsWith('.png') ? 'image/png' : 'image/jpeg' }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ ogTitle }}" />

    <!-- Twitter Card (Grand Format) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="{{ canonicalUrlClean }}" />
    <meta name="twitter:title" content="{{ ogTitle }}" />
    <meta name="twitter:description" content="{{ ogDescription }}" />
    <meta name="twitter:image" content="{{ ogImage }}" />
    <meta name="google-site-verification" content="FG2c9f-hkl06D6yfIYglb0fY-QAemupfGc6LXnfFEMY" />

    <!-- Données structurées Schema.org (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Church",
        "name": "Phila Maison de Témoignages",
        "alternateName": ["Phila MDT", "MDT Church"],
        "url": "https://philamdt.church",
        "logo": "https://philamdt.church/logo.png",
        "image": "https://philamdt.church/mdt-banner.jpg",
        "description": "Phila Maison de Témoignages (MDT) est une église dynamique, un lieu où Dieu transforme des vies en témoignages vivants."
      }
    </script>

    <!-- Préconnexion Google Fonts (optimisation chargement typographie) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- DNS Prefetch domaines tiers (reCAPTCHA, YouTube, Cloudinary) -->
    <link rel="dns-prefetch" href="https://www.google.com" />
    <link rel="dns-prefetch" href="https://www.gstatic.com" />
    <link rel="dns-prefetch" href="https://i.ytimg.com" />
    <link rel="dns-prefetch" href="https://www.youtube-nocookie.com" />
    <!-- Preload conditionnel LCP par page (serveur) -->
    @if(page?.component === 'home')
      <link rel="preload" as="image" href="/mdt-banner.webp" type="image/webp" fetchpriority="high" />
    @elseif(page?.component === 'a-propos')
      <link rel="preload" as="image" href="/about-mdt.webp" type="image/webp" fetchpriority="high" />
    @endif

    <link rel="dns-prefetch" href="https://res.cloudinary.com" />

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
      />
    </noscript>

    <!-- Favicon & Icônes (Normes Google Search & Mobile) -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    @viteReactRefresh()
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5PGL39XB"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    @inertia()
  </body>

</html>
