# ── Node ──────────────────────────────────────────────────────────────────────
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=production

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
APP_KEY=
APP_URL=https://philamdt.church

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=cookie

# ── Base de données (MySQL) ───────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=mdt

# ── Cloudinary (Médias, Photos & Galeries) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=philamdt
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ── Brevo : Rendez-vous Pastoral ──────────────────────────────────────────────
# Clé API et expéditeur utilisés pour les e-mails de rendez-vous pastoral
BREVO_API_KEY=
BREVO_SENDER_EMAIL=secretariat@philamdt.church
BREVO_SENDER_NAME="Phila MDT CHURCH"
# Destinataire des notifications (pasteur)
PASTOR_EMAIL=pasteur@philamdt.church

# ── Brevo : Formulaire de Contact & Newsletter ────────────────────────────────
# Clé API et expéditeur utilisés pour les e-mails de contact et de newsletter
CONTACT_BREVO_API_KEY=
CONTACT_SENDER_EMAIL=contact@philamdt.church
CONTACT_SENDER_NAME="Phila MDT CHURCH"
# Destinataire des messages de contact (secrétariat)
SECRETARIAT_EMAIL=contact@philamdt.church

# ── reCAPTCHA v2 (Google) ─────────────────────────────────────────────────────
# Obtenir sur https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=