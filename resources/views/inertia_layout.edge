<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title inertia>
      Phila MDT
    </title>

    <!-- SEO Meta Tags -->
    <meta
      name="description"
      content="Phila Maison de Témoignages (MDT) est une église dynamique, un lieu où Dieu transforme des vies en temoignages vivants, de partage et de communion fraternelle à travers nos cultes, ministères, cellules de maison et événements."
    />
    <meta
      name="keywords"
      content="phila mdt, église, maison de témoignages, culte, foi, prière, cellules de maison, louange, enseignements, chrétien, communauté"
    />
    <meta name="author" content="Phila MDT" />
    <meta name="robots" content="index, follow" />

    @assign(publicBaseUrl = (appUrl && !appUrl.includes('127.0.0.1') && !appUrl.includes('localhost')) ? appUrl.replace(/\/+$/, '') : 'https://philamdt.church')
    @assign(canonicalUrlClean = (canonicalUrl && !canonicalUrl.includes('127.0.0.1') && !canonicalUrl.includes('localhost')) ? canonicalUrl : publicBaseUrl)
    @assign(ogTitle = page?.props?.event?.title ? page.props.event.title + ' — Phila Maison de Témoignages' : 'Phila Maison de Témoignages')
    @assign(ogDescription = page?.props?.event?.description ? page.props.event.description.slice(0, 200) : 'Découvrez Phila Maison de Témoignages (MDT), notre agenda des cultes, ministères, événements et partagez la communion chrétienne.')
    @assign(ogImage = page?.props?.event?.image ? (page.props.event.image.startsWith('http') ? page.props.event.image : publicBaseUrl + (page.props.event.image.startsWith('/') ? '' : '/') + page.props.event.image) : publicBaseUrl + '/mdt-banner.jpg')

    <!-- Canonical URL (Défense contre l'usurpation SEO) -->
    <link rel="canonical" href="{{ canonicalUrlClean }}" />

    <!-- Open Graph / Facebook / WhatsApp (Détection dynamique Événement vs Pages statiques) -->
    <meta property="og:type" content="{{ page?.props?.event ? 'article' : 'website' }}" />
    <meta property="og:site_name" content="Phila Maison de Témoignages" />
    <meta property="og:url" content="{{ canonicalUrlClean }}" />
    <meta property="og:title" content="{{ ogTitle }}" />
    <meta property="og:description" content="{{ ogDescription }}" />
    <meta property="og:image" content="{{ ogImage }}" />
    <meta property="og:image:secure_url" content="{{ ogImage }}" />
    <meta property="og:image:type" content="{{ ogImage.endsWith('.png') ? 'image/png' : 'image/jpeg' }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ ogTitle }}" />

    <!-- Twitter Card (Grand Format) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="{{ canonicalUrlClean }}" />
    <meta name="twitter:title" content="{{ ogTitle }}" />
    <meta name="twitter:description" content="{{ ogDescription }}" />
    <meta name="twitter:image" content="{{ ogImage }}" />
    <meta name="google-site-verification" content="FG2c9f-hkl06D6yfIYglb0fY-QAemupfGc6LXnfFEMY" />

    <!-- Données structurées Schema.org (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Church",
        "name": "Phila Maison de Témoignages",
        "alternateName": ["Phila MDT", "MDT Church"],
        "url": "https://philamdt.church",
        "logo": "https://philamdt.church/logo.jpg",
        "image": "https://philamdt.church/mdt-banner.jpg",
        "description": "Phila Maison de Témoignages (MDT) est une église dynamique, un lieu où Dieu transforme des vies en témoignages vivants."
      }
    </script>

    <!-- Préconnexion Google Fonts (optimisation chargement typographie) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />

    @viteReactRefresh()
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    @inertia()
  </body>

</html>
